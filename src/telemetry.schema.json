{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Temperature Sensor Telemetry Event",
  "description": "Schema for validating one telemetry event received by the plugin.",
  "type": "object",
  "required": ["deviceId"],
  "properties": {
    "deviceId": {
      "type": "string",
      "minLength": 1
    },
    "temperature": {
      "type": "number",
      "minimum": -10,
      "maximum": 35
    },
    "humidity": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "pressure": {
      "type": "number",
      "minimum": 300,
      "maximum": 1100
    },
    "led": {
      "type": "boolean"
    },
    "mode": {
      "type": "string"
    }
  },
  "additionalProperties": true
}